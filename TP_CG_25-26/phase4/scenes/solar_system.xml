<world>

    <window width="1080" height="720" />
    <camera>
        <position x="10" y="10" z="10" />
        <lookAt x="0" y="0" z="0" />
        <up x="0" y="1" z="0" />
        <projection fov="60" near="1" far="1000" />
    </camera>

    <lights>
        <!-- Sun as point light source -->
        <light type="point" posx="0" posy="0" posz="0" />
    </lights>

    <group>

        <!-- SUN -->
        <group>
            <transform>
                <scale x="3.0" y="3.0" z="3.0" />
            </transform>
            <models>
                <model file="sphere.3d">
                    <color>
                        <diffuse  R="255" G="200" B="50"  />
                        <ambient  R="255" G="200" B="50"  />
                        <specular R="255" G="255" B="200" />
                        <emissive R="255" G="180" B="30"  />
                        <shininess value="10" />
                    </color>
                </model>
            </models>
        </group>

        <!-- MERCURY -->
        <group>
            <transform>
                <rotate time="5" x="0" y="1" z="0" />
                <translate x="8" y="3" z="0" />
                <scale x="0.4" y="0.4" z="0.4" />
            </transform>
            <models>
                <model file="sphere.3d">
                    <texture file="textures/mercury.jpg" />
                    <color>
                        <diffuse  R="169" G="169" B="169" />
                        <ambient  R="30"  G="30"  B="30"  />
                        <specular R="80"  G="80"  B="80"  />
                        <emissive R="0"   G="0"   B="0"   />
                        <shininess value="20" />
                    </color>
                </model>
