        <!-- TEAPOT orbiting -->
        <group>
            <transform>
                <translate time="69.35" align="True">
                    <point x="20" y="5" z="0" />
                    <point x="14" y="-10" z="-14" />
                    <point x="0" y="-15" z="-20" />
                    <point x="-14" y="-10" z="-14" />
                    <point x="-20" y="0" z="0" />
                    <point x="-14" y="10" z="14" />
                    <point x="0" y="15" z="20" />
                    <point x="14" y="10" z="14" />
                    <point x="20" y="5" z="0" />
                    <point x="14" y="-10" z="-14" />
                    <point x="0" y="-15" z="-20" />
                </translate>
                <rotate angle="-90" x="1" y="0" z="0" />
                <scale x="0.1" y="0.1" z="0.1" />
            </transform>
            <models>
                <model file="teapot.3d">
